#roster-wrapper { float: left; height: 1px; width: 170px; }

#chat_friends { float: left; height: 20px; color: rgb(0, 0, 0); font-weight: bold; padding-left: 33px; padding-top: 7px; width: 119px; cursor: pointer; }

#chat_friends:hover { float: left; height: 20px; background: rgb(216, 224, 233); color: rgb(0, 0, 0); font-weight: bold; padding-left: 33px; padding-top: 7px; width: 119px; cursor: pointer; }

#statusbar_wrapper { padding-top: 3px; float: left; }

#long-wrapper { float: left; }

#chatlog { float: left; padding: 3px; color: green; }

