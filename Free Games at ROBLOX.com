.chat-available { background: url("/web/20120402103557im_/http://www.roblox.com/CSS/Base/CSS/available.png"); height: 15px; width: 15px; float: left; }

.chat-default { height: 15px; width: 15px; float: left; }

.chat_send_button { background: rgb(238, 238, 238); border-image: initial; float: left; line-height: 17px; height: 18px; border-width: 0px 0px 0px 2px; border-left-style: solid; border-left-color: rgb(204, 204, 204); border-bottom-style: initial; border-bottom-color: initial; border-right-style: initial; border-right-color: initial; border-top-style: initial; border-top-color: initial; padding: 3px; cursor: pointer; }

.chat_send_button:hover { background: rgb(216, 224, 233); border-image: initial; float: left; line-height: 17px; height: 18px; border-width: 0px 0px 0px 2px; border-left-style: solid; border-left-color: rgb(204, 204, 204); border-bottom-style: initial; border-bottom-color: initial; border-right-style: initial; border-right-color: initial; border-top-style: initial; border-top-color: initial; padding: 3px; cursor: pointer; }

.chat_send_input { border: 0px solid rgb(255, 255, 255); float: left; height: 22px; font-size: 12px; padding: 2px; }

.chat_close { cursor: pointer; color: rgb(255, 255, 255); font-size: 16px; line-height: 11px; padding-right: 8px; float: left; padding-top: 6px; }

.chat_close:hover { cursor: pointer; color: rgb(0, 0, 0); font-size: 16px; line-height: 11px; padding-right: 8px; float: left; padding-top: 6px; }

.chat_entry_click { cursor: pointer; padding: 6px 10px 7px; }

.chat_entry { float: left; background: rgb(216, 224, 233); height: 27px; color: rgb(0, 0, 0); font-weight: bold; cursor: pointer; width: 221px; }

