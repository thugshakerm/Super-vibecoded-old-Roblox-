.ShadowedStandardBox .Content { position: relative; z-index: 0; border: 2px solid rgb(110, 153, 201); background-color: white; height: 100%; padding: 10px; }

.Shadow { display: block; height: 100%; width: 100%; position: absolute; top: 6px; left: 6px; z-index: -1; background: url("/web/20120402103557im_/http://www.roblox.com/images/ShadowAlpha.png") right bottom no-repeat !important; }

