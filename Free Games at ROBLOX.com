.OldAlertSpace .robux_icon { background-position: -33px 0px; height: 12px; width: 16px; margin: 3px; float: left; }

.OldAlertSpace .tickets_icon { background-position: -49px 0px; height: 16px; width: 16px; margin: 3px; float: left; }

.OldAlertSpace .friends_icon { background-position: -78px 0px; height: 14px; width: 12px; margin: 3px; float: left; }

