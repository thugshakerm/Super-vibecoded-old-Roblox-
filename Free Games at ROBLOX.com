#chat { float: left; }

.chat_box { border-left: 2px solid rgb(110, 153, 201); border-right: 2px solid rgb(110, 153, 201); width: 217px; float: left; height: 280px; overflow-y: scroll; background: rgb(238, 238, 238); font-size: 11px; font-family: Verdana; }

.chat_text { width: 80%; padding: 4px; float: left; font-size: 11px; font-family: Verdana; }

.chat_name { color: rgb(136, 169, 191); border-bottom: 1px solid rgb(204, 204, 204); font-weight: bold; padding: 3px; float: left; font-size: 11px; font-family: Verdana; width: 75%; }

.chat_header { width: 211px; float: left; background: rgb(110, 153, 201); color: rgb(0, 0, 0); font-weight: bold; font-size: 12px; margin: 0px; padding: 5px; font-family: Verdana; }

.chat_options { width: 219px; float: left; background: rgb(110, 153, 201); color: rgb(0, 0, 0); font-weight: bold; font-size: 12px; margin: 0px; padding: 1px; font-family: Verdana; }

#chat_close { background: url("/web/20120402103557im_/http://www.roblox.com/CSS/Base/CSS/close.png"); height: 10px; width: 10px; float: right; cursor: pointer; margin-right: 1px; }

#chat_mini { background: url("/web/20120402103557im_/http://www.roblox.com/CSS/Base/CSS/mini.png"); height: 10px; width: 10px; float: right; cursor: pointer; margin-right: 5px; }

.chat_abuse { background: yellow; color: rgb(0, 0, 0); font-weight: bold; padding: 1px; cursor: pointer; font-family: Verdana; font-size: 7px; float: left; }

.chat_abuse:hover { background: red; color: rgb(0, 0, 0); font-weight: bold; padding: 1px; cursor: pointer; font-family: Verdana; font-size: 7px; float: left; }

.chat_wrapper { width: 221px; background: rgb(238, 238, 238); position: absolute; bottom: 0px; float: left; z-index: 1022; margin-left: 3px; }

#chatfix { position: fixed; bottom: 0px; left: 176px; z-index: 1337; }

.chat_input { float: left; background: rgb(238, 238, 238); border-width: 1px 2px 2px; border-style: solid; border-color: rgb(110, 153, 201); width: 217px; }

.chat_contents { bottom: 27px; display: none; }

.roster_box { border-bottom: 2px solid rgb(188, 188, 188); float: left; cursor: pointer; padding: 4px; width: 125px; }

.roster_box:hover { border-bottom: 2px solid rgb(188, 188, 188); float: left; cursor: pointer; background: rgb(238, 238, 238); padding: 4px; width: 125px; }

.roster_name { margin-left: 5px; }

.roster_alert { margin: 1px; padding: 1px; font-size: 11px; font-family: Verdana; }

