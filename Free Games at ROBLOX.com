.GroupWallPane .loading { display: none; position: absolute; top: 0px; height: 100%; width: 100%; }

.GroupWallPane .loading .content { position: absolute; top: 0px; height: 100%; width: 100%; background: url("/web/20120402103557im_/http://www.roblox.com/images/spinners/spinner100x100.gif") center center no-repeat; z-index: 1; }

.GroupWallPane .loading .background { position: absolute; top: 0px; height: 100%; width: 100%; background: rgb(255, 255, 255); }

