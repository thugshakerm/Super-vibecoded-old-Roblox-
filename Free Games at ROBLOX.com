.OldAlertSpace .MessageAlert a:hover { color: rgb(24, 116, 205); }

.OldAlertSpace .RobuxAlert { padding-top: 2px; vertical-align: middle; width: 49%; float: left; overflow: hidden; border-top: 1px solid rgb(110, 153, 201); background: rgb(255, 255, 255); height: 29px; }

.OldAlertSpace .RobuxAlert a { color: green; vertical-align: middle; }

.OldAlertSpace .RobuxAlert a:hover { color: rgb(73, 183, 69); }

.OldAlertSpace .TicketsAlert { padding-top: 2px; vertical-align: middle; width: 49%; float: left; overflow: hidden; border-left: 1px solid rgb(110, 153, 201); border-top: 1px solid rgb(110, 153, 201); background: rgb(255, 255, 255); height: 29px; }

.OldAlertSpace .TicketsAlert a { color: rgb(251, 177, 23); vertical-align: middle; }

.OldAlertSpace .TicketsAlert a:hover { color: rgb(255, 48, 0); }

.OldAlertSpace .FriendsAlert { color: rgb(136, 48, 0); vertical-align: middle; width: 49%; float: left; height: 32px; overflow: hidden; border-left: 1px solid rgb(110, 153, 201); background: rgb(255, 255, 255); }

.OldAlertSpace .FriendsAlert a { color: rgb(136, 48, 0); vertical-align: middle; }

