.OldAlertSpace .TicketsAlert { border: none; background: none; }

.OldAlertSpace .TicketsAlert a { left: 79px; top: 28px; color: rgb(170, 102, 17); background-position: -2px -121px; }

.OldAlertSpace .TicketsAlert a:hover { color: rgb(255, 187, 102); background-position: -2px -141px; }

body { background: rgb(230, 230, 230) !important; }

div#Body { padding-top: 0px; padding-bottom: 20px; width: 900px; min-height: 550px !important; background: white !important; margin: 0px auto !important; }

.BannerCenterContainer { width: 902px; margin-left: auto; margin-right: auto; text-align: center; }

#Container { padding: 0px; width: 100% !important; background: white !important; border: 0px !important; }

#MasterContainer { background: rgb(230, 230, 230); overflow: visible; }

div#Footer { width: 100%; padding: 2em 0px 0px; }

div#AdvertisingLeaderboard { margin-bottom: 10px; width: 875px; padding-top: 0px !important; }

#SmallHeaderContainer { position: fixed; width: 100%; height: 40px !important; z-index: 200 !important; }

.BadAdButton:link { color: rgb(128, 128, 128) !important; font-family: inherit !important; }

a.BadAdButton:hover { border: 0px; text-decoration: underline; color: rgb(128, 128, 128) !important; font-family: inherit !important; }

div#PlayNowButton, div#Banner { background-color: rgb(0, 89, 209) !important; height: 38px !important; }

#SmallHeaderContainer #Banner #Alerts { height: 38px !important; padding-top: 0px !important; }

#SmallHeaderContainer #PlayNowButton { margin-right: 20px !important; }

.SignUpAndPlay { float: right !important; padding-right: 20px; }

.SmallHeaderAlertSpaceLeft .AlertSpace { float: right; border: none; position: relative; top: 0px; width: auto; margin: 0px auto; padding-right: 60px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; font-weight: bold; padding-left: 9px; padding-top: 1px; background: url("/web/20120402103557im_/http://www.roblox.com/images/cssspecific/rbx2/bg-statbar-right-28h.png") right 0px no-repeat scroll transparent !important; height: 28px !important; }

.SmallHeaderAlertSpaceLeft { background: url("/web/20120402103557im_/http://www.roblox.com/images/cssspecific/rbx2/head_bkg_t1.png") left center no-repeat scroll; height: 28px; right: 2px; padding-left: 3px; float: right; }

div#AuthenticatedUserName { padding-left: 12px; top: auto !important; width: auto !important; position: static !important; }

.dropdownnavcontainer { margin-left: 25% !important; }

#SmallHeaderContainer #Banner #AuthenticationButton #AuthenticationBannerSpanLeft { width: 60px !important; padding: 0px !important; }

span#AuthenticationBannerSpan { width: 37px; float: right; height: 28px !important; display: block !important; }

#SmallHeaderContainer #Banner { height: 38px !important; }

div#AuthenticationButton { margin-top: 0px !important; top: 0px !important; }

#SmallHeaderContainer #Banner #AuthenticatedUserName { top: 0px; position: inherit; }

a.btn-playnow, a.btn-playnow:visited { background: url("/web/20120402103557im_/http://www.roblox.com/images/btn-playnow_small.png") left top; display: block; width: 117px; height: 34px; float: right; position: relative; top: 2px; }

a.btn-playnow:hover { background-position: left bottom; }

a.btn-logo, a.btn-logo:visited { background: url("/web/20120402103557im_/http://www.roblox.com/images/btn-logo.png") left top; display: inline-block; width: 123px; height: 38px; float: left; }

a.btn-logo:hover { background-position: left bottom; }

a.logoutButton { margin-left: -2px !important; padding-top: 2px !important; position: static !important; top: auto !important; }

a.loginButton { margin-left: 7px !important; }

.loginSpan { top: 17px; position: relative; float: left; }

img#over13icon { float: right; top: 18px; position: relative; padding-left: 6px; }

#SmallHeaderContainer #Banner #AuthenticationButton a { text-align: center !important; margin-top: 5px !important; height: 15px !important; padding-top: 2px !important; }

#SmallHeaderContainer #Banner #AuthenticationButton a:hover { text-decoration: none; }

#SmallHeaderContainer #Banner #AuthenticationButton #AuthenticationBannerSpanLeft #AuthenticationBannerSpan { width: 57px !important; padding: 0px !important; }

div.AlertSpace { float: none !important; margin: 0px !important; }

.subMenu { background: rgb(54, 54, 54); z-index: 200 !important; margin: 0px auto !important; }

.BadAdButton { top: -2px; }

.AdPanel { display: inline; }

div#Nav { position: fixed; display: block; top: 38px !important; z-index: 1000 !important; }

div#Header { text-align: left; }

div.ProfileAlertPanel .SmallHeaderAlertSpaceLeft { background: none !important; float: none !important; height: 50px !important; }

div.ProfileAlertPanel .SmallHeaderAlertSpaceLeft .AlertSpace { height: 50px !important; background: none !important; }

div.mySubmenuFixed { position: fixed; top: 68px; width: 100%; z-index: 800; }

div.forceSpaceUnderSubmenu { padding-bottom: 13px; }

div#testingSitePanelNew { margin: 0px auto 8px; width: 870px; text-align: center; border: 3px solid rgb(255, 224, 102); padding: 10px 5px; }

.loginNewStyle { padding-top: 63px; height: 655px; }

div.forceSpace { padding-top: 62px; background: white; }

.ShadowedStandardBox .Content { background: none; border-width: 0px 0px 1px; border-top-style: initial; border-right-style: initial; border-left-style: initial; border-top-color: initial; border-right-color: initial; border-left-color: initial; border-image: initial; border-bottom-style: solid; border-bottom-color: rgb(204, 204, 204); }

div.DGBContainerLong, div.DGBContainerShort { height: auto; text-align: left; }

a.ControlLoginButton { background: url("/web/20120402103557im_/http://www.roblox.com/images/UI/btn-big_silver_tile.png") left top; display: block; width: 88px; height: 18px; font-family: Arial !important; font-size: 16px !important; font-weight: bold !important; color: rgb(0, 0, 0) !important; border: 1px solid rgb(188, 188, 188) !important; }

a.ControlLoginButton:hover { background-position: left bottom; }

.FrontPageLoginBox { background: rgb(225, 225, 225); border: 1px solid rgb(188, 188, 188); height: 248px; width: 160px; margin-right: 10px; text-align: center; }

label.DGB_Label { font-family: Arial !important; font-size: 11px !important; font-weight: normal !important; }

.DGB_Header { text-transform: uppercase; font-family: Arial !important; font-size: 16px !important; font-weight: bold !important; padding-top: 8px !important; }

.DarkGradientBox .DGB_TextBox { width: 155px; height: 18px !important; border: 1px solid rgb(188, 188, 188) !important; }

.DarkGradientBox { width: auto; }

div.TextInputLogin { margin: 0px; padding: 0px; }

a.RobloxFreeBuildingBanner { background: url("/web/20120402103557im_/http://www.roblox.com/images/UI/img-free_building_banner.jpg") left top; display: block; height: 90px; width: 578px; }

a.RobloxFreeBuildingBanner:hover { background-position: left bottom; }

a.SignupButtonImage { background: url("/web/20120402103557im_/http://www.roblox.com/images/UI/btn-sign_up.png") left top; display: block; width: 102px; height: 34px; margin: 0px auto; }

a.SignupButtonImage:hover { background-position: left bottom; }

a.PlayThisFeaturedGame { background: url("/web/20120402103557im_/http://www.roblox.com/images/UI/btn-play_this.png") left top; display: block; width: 112px; height: 34px; margin: 0px 0px 15px; }

a.PlayThisFeaturedGame:hover { background-position: left bottom; }

.FeaturedGameAssetImage { float: left; }

div.FeaturedGameInfo { float: right; font-family: Arial; line-height: 140%; width: 155px; }

.FeaturedGameBox { border-bottom: 1px solid rgb(204, 204, 204); height: 320px; font-family: Arial; padding-top: 5px; }

.FeaturedGameBox h2 { font-size: 40px; font-weight: bold; color: rgb(54, 54, 54); letter-spacing: -2px; display: block; }

span.placeName { font-size: 16px; font-weight: bold; color: rgb(0, 0, 0); text-transform: uppercase; }

div.FeaturedGame { padding: 10px 0px; }

div.TopPanel { min-height: 252px; float: left; border-bottom: 1px solid rgb(204, 204, 204); padding: 5px 0px; }

div.overrideColumn1c { padding: 5px 0px; width: 589px; }

div.overrideColumn2c { width: 310px; border-left: 1px solid rgb(204, 204, 204); padding-top: 8px; }

div.FeaturedGameInfo .PlaceStatValue { margin: 0px 0px 8px; font-size: 12px; }

div.FeaturedGameInfo .PlaceStatLabel { color: rgb(70, 70, 70); font-size: 10px; }

div.SidePanel p { color: rgb(0, 0, 0); margin: 0px 0px 8px; }

div.SidePanel img { margin-right: 10px; }

div.SidePanel { border-top: 1px solid rgb(204, 204, 204); font-family: Arial; padding-top: 10px; padding-bottom: 10px; padding-left: 10px; }

div.SidePanel h2 { display: block; font-size: 16px; font-weight: bold; color: black; text-transform: uppercase; margin-bottom: 10px; }

div.ParentsSpacing a { font-weight: bold; margin: 0px 10px; }

.SidePanel #RobloxNews { font-size: 12px; }

#RobloxNews a { margin-right: 5px; }

.RandomFactTextContainer { text-align: left !important; }

.separateSignUpFromLoginWithBorder { margin-top: 10px; border-top: 1px solid rgb(189, 189, 189); }

.FeaturedGameButton { background: url("/web/20120402103557im_/http://www.roblox.com/images/buttons/btn-playnow_big2.png") no-repeat; width: 214px; height: 214px; overflow: hidden; }

.FeaturedGameButton:hover { background-position: 0px -214px; }

div.GiftCards { height: 625px; }

.GiftCards #CreateHeader { color: rgb(54, 54, 54); font: bold 40px Arial; margin: 10px 0px 0px 14px; letter-spacing: -2px; }

.GiftCards .GiftHeader { color: black; font: bold 16px Arial; margin: 10px 0px; text-transform: uppercase; }

.GiftCards .GiftFieldLabel { color: black; display: inline-block; font-weight: bold; padding-left: 10px; width: 120px; }

.GiftCards #GiftForm { background: rgb(225, 225, 225); padding: 10px; width: 400px; color: black; border: 1px solid rgb(167, 167, 167); }

.GiftCards #PurchaseButtonContainer { color: black; }

.GiftCards #GiftForm span#remainingCharacters { color: black; font-size: 10px; }

div.FeaturedGameImage { float: left; }
