@charset "utf-8";

.voting-panel .loading { position: absolute; height: 100%; width: 100%; background: url("/web/20140114053048im_/http://www.roblox.com/images/ProgressIndicator4.gif") center center no-repeat rgb(255, 255, 255); z-index: 1; display: none; }

.voting-panel { max-width: 370px; }

.users-vote .upvote, .users-vote .downvote { height: 21px; width: 22px; background: url("/web/20140114053048im_/http://www.roblox.com/images/Icons/thumbsup.png?1") 0px 0px no-repeat; float: left; }

.voting-panel .users-vote, .voting-panel .vote-summary { float: left; font-size: 11px; }

.voting-panel .vote-summary { margin-left: 10px; }

.users-vote .downvote { background-position: 5px -85px; margin-left: 5px; padding-left: 5px; }

.users-vote.has-voted .upvote:hover, .users-vote .upvote:hover { background-position: 0px -21px; cursor: pointer; }

.users-vote.has-voted .upvote.selected { background-position: 0px -41px; }

.users-vote.has-voted .upvote { background-position: 0px -63px; }

.users-vote.has-voted .downvote:hover, .users-vote .downvote:hover { background-position: 5px -106px; cursor: pointer; }

.users-vote.has-voted .downvote.selected { background-position: 5px -149px; }

.users-vote.has-voted .downvote { background-position: 5px -128px; }

.users-vote .upvote.tiny { background-position: 0px -170px; }

.users-vote .upvote.tiny:hover, .users-vote.has-voted .upvote.tiny:hover, .users-vote.has-voted .upvote.tiny.selected:hover { background-position: 0px -183px; cursor: pointer; }

.users-vote.has-voted .upvote.tiny.selected { background-position: 0px -196px; }

.users-vote.has-voted .upvote.tiny { background-position: 0px -210px; }

.users-vote .downvote.tiny { background-position: 0px -223px; }

.users-vote .downvote.tiny:hover, .users-vote.has-voted .downvote.tiny:hover, .users-vote.has-voted .downvote.tiny.selected:hover { background-position: 0px -236px; cursor: pointer; }

.users-vote.has-voted .downvote.tiny.selected { background-position: 0px -264px; }

.users-vote.has-voted .downvote.tiny { background-position: 0px -251px; }

.voting-panel .total-upvotes { padding-right: 5px; display: inline; }

.voting-panel .total-upvotes span { border: 0px; }

.voting-panel .total-downvotes { padding-left: 5px; display: inline; }

.voting-panel .visual-container { position: relative; height: 5px; margin-top: 5px; }

.voting-panel .percent, .voting-panel .background { position: absolute; width: 100%; height: 5px; bottom: 0px; }

.voting-panel .percent { width: 0px; }

.tiny-thumbs-up, .tiny-thumbs-down, .upvote.tiny, .downvote.tiny { background: url("/web/20140114053048im_/http://www.roblox.com/images/Icons/thumbsup.png?1") 0px -170px no-repeat; width: 12px; height: 13px; padding-right: 5px; zoom: 1; display: inline-block; position: relative; top: 2px; }

.tiny-thumbs-down { background-position: 0px -224px; margin-right: 0px; padding-right: 0px; margin-left: 5px; top: 2px; }

.voting-panel .visual-container .background { background-color: rgb(204, 204, 204); }

.voting-panel .visual-container .background.votes { background-color: rgb(206, 100, 91); }

.voting-panel .visual-container .percent { background-color: rgb(82, 168, 70); }

.voting-panel .voting-details { text-align: center; }

#GetOrUseAccessCodeModal { width: 700px; min-height: 191px; padding: 5px; }

#GetOrUseAccessCodeModal div.Message { width: 690px; min-height: 130px; padding: 14px 5px 5px; background-color: rgb(255, 255, 255); margin-top: 5px; }

#GetOrUseAccessCodeModal div.Message .column { width: 280px; text-align: center; }

#GetOrUseAccessCodeModal div.Message h2 { margin-bottom: 5px; }

#HaveAccessCodeSection { float: left; padding: 5px 30px; }

#NeedAccessCodeSection { float: left; margin-left: 30px; padding-top: 5px; }

#AccessCodeInput { width: 95%; height: 16px; }

#GeneratedAccessCodeContainer { height: 22px; }

#GetOrUseAccessCodeModal div.Message .action-button { margin-top: 10px; padding-top: 3px; padding-bottom: 1px; }

#ProgressIndicator { height: 20px; background-image: url("/web/20140114053048im_/http://www.roblox.com/images/Accounts/ProgressIndicator.gif"); background-repeat: no-repeat; margin-left: 315px; margin-top: 40px; }

div#navigation-menu { display: inline-block; min-height: 36px; z-index: 1000; float: left; color: rgb(255, 255, 255); text-decoration: none; height: 30px; text-align: left; line-height: 20px; }

