@charset "utf-8";

#partycontainer { bottom: 110px; right: 10px; }

.partyWindow { color: rgb(102, 102, 102); font-family: Verdana, Geneva, sans-serif; font-size: 11px; width: 250px; }

.partyWindow .title { background: url("/web/20120331193427im_/http://www.roblox.com/images/friendsbar/tab_blue19h_l.gif") left top no-repeat transparent; display: block; text-decoration: none; padding-left: 2px; height: 19px; width: 248px; cursor: pointer; }

.partyWindow .title span { background: url("/web/20120331193427im_/http://www.roblox.com/images/friendsbar/tab_blue19h_r.gif") right top no-repeat transparent; display: block; height: 15px; padding: 2px 15px 2px 7px; text-decoration: none; color: rgb(255, 255, 255); }

.partyWindow .title_flash { background: url("/web/20120331193427im_/http://www.roblox.com/images/friendsbar/tab_white19h_l2.gif") left top no-repeat transparent; }

.partyWindow .title_flash span { background: url("/web/20120331193427im_/http://www.roblox.com/images/friendsbar/tab_white19h_r2.gif") right top no-repeat transparent; color: rgb(68, 68, 68); }

.partyWindow .title strong { display: block; padding: 2px 15px 4px 6px; background: url("/web/20120331193427im_/http://www.roblox.com/images/chat/tab_blue21h_r.png") right top no-repeat; color: rgb(255, 255, 255); width: 227px; font-weight: bold; }

.partyWindow .closeparty { width: 10px; height: 9px; margin: 5px 9px 0px 0px; cursor: pointer; position: absolute; right: 0px; top: 0px; color: rgb(255, 255, 255); font-weight: bold; font-size: 14px; }

.partyWindow .main { clear: both; width: 248px; height: auto; margin: 0px; background: rgb(242, 242, 242); border-width: 0px 1px 1px; border-style: none solid solid; border-right-color: rgb(166, 166, 166); border-bottom-color: rgb(166, 166, 166); border-left-color: rgb(166, 166, 166); border-image: initial; border-top-color: initial; overflow: auto; }

.partyWindow .kickuser { float: right; padding-right: 5px; color: red; cursor: pointer; }

#new_party p { text-align: center; padding: 40px 0px 0px; }

#party_none .main .btn_green21h { margin: 15px 0px 0px 77px; }

.clear { clear: both; }

.main #new_party_clear { padding: 40px 0px 0px; }

.btn_green21h { float: left; background: url("/web/20120331193427im_/http://www.roblox.com/images/chat/btn_green21h_l.png") left top no-repeat; padding: 0px 0px 0px 2px; }

.btn_green21h a { display: block; padding: 2px 14px 4px 10px; background: url("/web/20120331193427im_/http://www.roblox.com/images/chat/btn_green21h_r.png") right top no-repeat; color: white; font-family: verdana; font-weight: bold; text-decoration: none; }

.btn_green21h:hover { background: url("/web/20120331193427im_/http://www.roblox.com/images/chat/btn_green21h_over_l.png") left top no-repeat; }

.btn_green21h:hover a { background: url("/web/20120331193427im_/http://www.roblox.com/images/chat/btn_green21h_over_r.png") right top no-repeat; }

.btn_red21h { float: left; background: url("/web/20120331193427im_/http://www.roblox.com/images/chat/btn_red21h_l.png") left top no-repeat; padding: 0px 0px 0px 2px; }

.btn_red21h a { display: block; padding: 2px 14px 4px 10px; background: url("/web/20120331193427im_/http://www.roblox.com/images/chat/btn_red21h_r.png") right top no-repeat; color: white; font-family: verdana; font-weight: bold; text-decoration: none; }

.btn_red21h:hover { background: url("/web/20120331193427im_/http://www.roblox.com/images/chat/btn_red21h_over_l.png") left top no-repeat; }

