#Banner #AuthenticationButton a { background: url("/web/20120829073204im_/http://www.roblox.com/images/cssthemes/base/btn_blue.png") 0px 0px repeat-x scroll transparent; font-weight: bold; color: white; font-family: Arial; font-size: 10px; height: 16px; display: block; padding-top: 1px; text-align: center; width: 40px; margin-top: 1px; margin-left: 5px; }

#Banner #Options #Settings { bottom: 0px; left: 0px; padding: 4px; position: absolute; }

#Banner #Logo { height: 34px; left: 0px; position: absolute; top: 5px; width: 140px; margin: 0px; float: none; background: url("/web/20120829073204im_/http://www.roblox.com/images/cssthemes/base/img-robloxlogo.png") no-repeat; }

#SmallHeaderContainer #Banner #Alerts { background: transparent; border: none; position: relative; width: 350px; height: 40px; float: right; padding-top: 9px; }

#HeaderContainer #Banner #Alerts { float: right; border: 1px solid rgb(110, 153, 201); background: rgb(255, 255, 255); width: 203px; }

#Header .Navigation { clear: both; background-color: rgb(110, 153, 201); color: rgb(255, 255, 255); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-weight: normal; line-height: 2em; text-decoration: none; }

#AdvertisingLeaderboard { margin: 0px auto 10px; text-align: center; padding-top: 5px; width: 875px; }

#AdvertisingSkyscraper { border: 1px solid rgb(0, 0, 0); float: right; text-align: right; width: 120px; }

#RobloxLargeRectangleAd { padding: 10px 0px; }

#Footer { font: 13px Verdana, sans-serif; padding: 3em 20px; width: 860px; text-align: center; margin: 0px; }

#Footer .SEOGenreLinks { padding: 1em 0px 2em; font-size: 11px; }

#Footer .Legalese { color: rgb(85, 85, 85); font-size: 10px; margin-bottom: 1em; }

#Footer .legal { text-align: left; width: 900px; margin: 0px auto; }

#Footer .legal .left { float: left; margin: 0px 5px; }

#Footer .legal .right { float: left; width: 800px; }

#Footer .legal #bbblink { display: inline-block; }

#Footer .legal #TrusteLogo { vertical-align: top; }

.AdmiPanel { border: 1px solid rgb(0, 0, 0); bottom: 20px; overflow: hidden; right: 10px; padding-top: 15px; position: fixed; width: 200px; }

.AdmiPanel h4 { background-color: rgb(204, 204, 204); border-bottom: 1px solid rgb(0, 0, 0); color: rgb(51, 51, 51); margin: 0px; text-align: center; }

.AdmiPanelExpandCollapse { color: green; cursor: pointer; font-weight: bolder; position: absolute; right: 2px; top: 2px; }

.Panel { border: 1px solid rgb(0, 0, 0); }

.Panel h4 { background-color: rgb(204, 204, 204); border-bottom: 1px solid rgb(0, 0, 0); color: rgb(51, 51, 51); margin: 0px; text-align: center; }

.MultilineTextBox { border: 2px dashed gray; font-family: Verdana, sans-serif; font-size: 1.2em; line-height: 1.5em; padding: 5px; }

.TextBox { border: 1px solid rgb(204, 204, 204); font-family: Verdana, sans-serif; font-size: 1.2em; padding: 5px; }

.Label { font-weight: bold; }

.BigButton { background-color: rgb(245, 205, 47); color: rgb(0, 0, 0); height: 2.5em; font-family: Verdana, Helvetica, sans-serif; font-size: 20px; font-weight: bold; }

.BigButtonDisabled { background-color: rgb(192, 192, 192); color: rgb(0, 0, 0); height: 2.5em; font-family: Verdana, Helvetica, sans-serif; font-size: 20px; font-weight: bold; }

.ErrorReporting, .ErrorReportingThanks { width: 500px; margin: 16px auto; padding: 10px; }

.YesNoButtons { text-align: right; }

.YesButton, .NoButton { background-color: rgb(245, 205, 47); color: rgb(0, 0, 0); margin-left: 10px; }

.popupControl { background-color: rgb(255, 255, 255); border: 1px outset rgb(255, 255, 255); position: absolute; visibility: hidden; z-index: 1; }

.ColorPickerItem { border-color: rgb(255, 255, 255); border-style: solid; border-width: 2px; }

.ColorPickerItem:hover { border-color: blue; border-style: solid; border-width: 2px; }

