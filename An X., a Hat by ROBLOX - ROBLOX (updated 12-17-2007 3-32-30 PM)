.SystemAlert a { color: white; }

.Exclamation { background: url("/web/20121009193020im_/http://www.roblox.com/images/Icons/exclamation.png") no-repeat; height: 16px; width: 16px; float: left; }

.EmailTemplateTable { border-collapse: collapse; }

