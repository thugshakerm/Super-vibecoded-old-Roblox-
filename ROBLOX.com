.AlertSpace .robux_icon { background-position: -33px 0px; height: 12px; width: 16px; margin: 2px 3px 3px; float: left; }

.AlertSpace .tickets_icon { background-position: -49px 0px; height: 16px; width: 16px; margin: -1px 3px 3px; float: left; }

.AlertSpace .friends_icon { background-position: -78px 0px; height: 14px; width: 12px; margin: 1px 3px 3px; float: left; }

.OldAlertSpace { color: rgb(110, 153, 201); margin: 0px auto; font-weight: bold; }

