.TradingPartner { color: rgb(0, 0, 0); font-family: Arial; font-size: 11px; font-weight: 400; }

.MakeTradeButton, .MakeTradeButton:hover, .MakeTradeButton.disabled { background: url("/web/20130528173607im_/https://www.roblox.com/images/buttons/btn-make_trade.png") center top; height: 50px; width: 179px; margin: 0px auto; }

.MakeTradeButton:hover { background: url("/web/20130528173607im_/https://www.roblox.com/images/buttons/btn-make_trade.png") center bottom; cursor: pointer; }

