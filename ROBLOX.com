div.Signup { margin: 0px 5px 0px auto; color: rgb(102, 102, 102); float: left; background: rgb(225, 225, 225); border: 1px solid rgb(188, 188, 188); height: 248px; width: 260px; text-align: center; }

div.Signup h2 { text-align: center; border-bottom: none; text-transform: uppercase; font-family: Arial; font-size: 16px; font-weight: bold; padding-top: 9px; color: black; }

div.Signup .formRow { float: left; width: 250px; padding: 2px 0px 6px 13px; }

div.Signup .formRow label { float: left; padding: 0px; width: 60px; text-align: left; font-size: 11px; color: black; top: -3px; position: relative; }

div.Signup .formRow input { float: left; border: 1px solid rgb(153, 153, 153); padding: 3px; width: 140px; }

div.Signup .formRow select { padding: 1px; margin: 0px; }

