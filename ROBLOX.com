.catalog_nav { color: white; font-family: Arial, Helvetica, sans-serif; font-size: 14px; position: relative; z-index: 5; float: right; }

.catalog_nav ul { padding: 0px; margin: 0px; list-style-type: none; }

.catalog_nav li { float: left; position: relative; text-align: center; }

.catalog_nav a, .catalog_nav a:visited { background: url("/web/20130528173607im_/https://www.roblox.com/images/tabmiddle.png") repeat-x rgb(185, 206, 229); display: block; padding: 5px; margin-right: 4px; font-size: 14px; color: rgb(255, 255, 255); height: 18px; cursor: pointer; }

.catalog_nav .catalog_navselected { display: block; background: url("/web/20130528173607im_/https://www.roblox.com/images/tabmiddleselected.png") repeat-x rgb(110, 153, 201); padding: 5px 10px; margin-right: 4px; font-size: 14px; color: rgb(255, 255, 255); font-weight: bold; text-decoration: none; height: 18px; }

.catalog_nav ul ul a.catalog_navdrop, t.menu ul ul a.catalog_navdrop:visited { font-weight: bold; text-decoration: none; }

.catalog_nav ul ul ul a:hover { text-decoration: underline; }

.catalog_nav ul ul { visibility: hidden; position: absolute; height: 0px; left: 0px; z-index: 20; }

.catalog_nav ul ul ul { left: 141px; top: 0px; width: 89px; }

.catalog_nav ul ul ul.left { left: -149px; }

.catalog_nav ul ul a, .catalog_nav ul ul a:visited { color: rgb(255, 255, 255); background: rgb(110, 153, 201); padding: 4px 6px; line-height: 1em; width: 78px; margin-right: 4px; z-index: 20; height: 18px; }

.catalog_nav img { border: 0px; margin-right: 3px; vertical-align: middle; }

.catalog_nav a:hover { text-decoration: none; background: url("/web/20130528173607im_/https://www.roblox.com/images/tabmiddleselected.png") repeat-x rgb(110, 153, 201); }

.catalog_nav ul ul a:hover { text-decoration: none; background: rgb(81, 113, 148); }

.catalog_nav :hover > a, .catalog_nav ul ul :hover > a { text-decoration: none; }

.catalog_nav ul li:hover ul, .catalog_nav ul a:hover ul { visibility: visible; }

.catalog_nav ul :hover ul ul { visibility: hidden; }

.catalog_nav ul :hover ul :hover ul { visibility: visible; }

.catalog_nav table { position: absolute; top: 0px; margin-top: 15px; left: 0px; border-collapse: collapse; background: rgb(110, 153, 201); display: none; }

.catalog_nav table a, .catalog_nav table a:visited { border: none; width: 78px; padding-top: 8px; }

