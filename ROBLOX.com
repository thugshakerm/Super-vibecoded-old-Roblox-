.Shadow { display: block; height: 100%; width: 100%; position: absolute; top: 6px; left: 6px; z-index: -1; background: url("/web/20130528173607im_/https://www.roblox.com/images/ShadowAlpha.png") right bottom no-repeat !important; }

.ShadowedStandardBox .Button { cursor: pointer; background-color: rgb(182, 204, 228); color: rgb(67, 93, 119); text-decoration: none; border: 1px solid rgb(204, 204, 204); padding: 3px 10px; font-family: Verdana; font-size: 10px; font-weight: bold; text-align: center; white-space: nowrap; }

.ShadowedStandardBox .Button:link, .ShadowedStandardBox .Button:visited { background-color: rgb(182, 204, 228); color: rgb(67, 93, 119); text-decoration: none; }

.ShadowedStandardBox .Button:hover, .ShadowedStandardBox .Button:active { background-color: rgb(95, 132, 168); color: white; text-decoration: none; }

.OutlineBox { z-index: 0; position: relative; margin-top: 16px; padding-top: 14px; margin-bottom: 10px; border: 2px solid rgb(182, 204, 228); }

.OutlineBox .OB_HeaderPositioner { z-index: 1; position: absolute; top: -16px; left: 0px; width: 100%; }

.OutlineBox .OB_Header { z-index: 1; display: block; width: 90%; margin-left: auto; margin-right: auto; background-color: white; border: 2px solid rgb(182, 204, 228); text-align: center; font-size: 18px; font-weight: bold; padding: 2px; }

.OutlineBox .OB_Content { padding-top: 5px; }

