.BlueRightArrow:hover { background: url("/web/20130528173607im_/https://www.roblox.com/images/arrow36px_rightOn.png") no-repeat; }

.BCHat { background: url("/web/20130528173607im_/https://www.roblox.com/images/Games/gamesPage_bcHelmet.png") no-repeat; width: 35px; height: 29px; display: inline-block; margin-top: 3px; }

.notificationBox { display: inline-block; background-color: rgb(255, 0, 0); color: rgb(255, 255, 255); height: 16px; min-width: 18px; width: auto; font-size: 14px; font-weight: bold; margin: 2px 2px 4px; padding: 0px 2px; line-height: 1.1em; text-align: center; border-radius: 2px; }

.notificationBoxIE { display: inline-block; color: rgb(255, 255, 255); background-image: url("/web/20130528173607im_/https://www.roblox.com/images/bg-notifications.png"); background-repeat: repeat-x; background-position: left top; min-width: 24px; width: auto; height: 16px; text-align: center; font-size: 14px; font-weight: bold; }

.gray-ok-button { background: url("/web/20130528173607im_/https://www.roblox.com/images/Buttons/btn-ok-gray.png") no-repeat; width: 102px; height: 50px; cursor: pointer; display: inline-block; }

.gray-ok-button:hover { background-position: 0px -50px; }

.learn-more-button { background: url("/web/20130528173607im_/https://www.roblox.com/images/Buttons/btn-learn_more.png") no-repeat; width: 159px; height: 50px; cursor: pointer; display: inline-block; }

.learn-more-button:hover { background-position: 0px -50px; }

.SimpleModal { background-color: rgb(225, 225, 225); border: 2px solid rgb(39, 39, 39); display: none; padding: 5px; position: absolute; width: 435px; }

.SimpleModal .titleBar { background-color: rgb(225, 225, 225); color: rgb(54, 54, 54); font: bold 27px Arial, Helvetica, sans-serif; height: 38px; letter-spacing: -2px; }

.SimpleModal .modalBody { background: rgb(255, 255, 255); padding: 5px; font: 15px Arial, sans-serif; }

.SimpleModal ul { margin: 0px; padding: 0px 15px; }

.SimpleModal li { margin: 10px 0px; }

#videoPrerollPanel { display: none; width: 713px; height: 473px; padding: 20px 20px 20px 35px; background-color: rgb(255, 255, 255); }

#videoPrerollTitleDiv { font-family: Arial, sans-serif; font-size: 17px; font-weight: bold; padding-bottom: 20px; }

#videoPrerollMainDiv { width: 391px; height: 312px; margin: 0px; padding: 0px; float: left; }

#videoPrerollCompanionAd { width: 300px; height: 250px; margin: 0px; padding-top: 25px; padding-left: 20px; float: left; }

#videoPrerollLoadingDiv { margin-left: auto; margin-right: auto; font-family: Arial, sans-serif; font-weight: bold; font-size: 12px; clear: both; width: 584px; padding-top: 30px; }

