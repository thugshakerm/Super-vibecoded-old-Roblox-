.SignupWrapper h1 { font-size: 40px; font-weight: bold; color: rgb(54, 54, 54); display: block; letter-spacing: -2px; }

.SignupWrapper .SignupBox { width: 540px; border-right: 1px solid rgb(204, 204, 204); float: left; margin-top: 25px; padding-top: 10px; }

.SignupWrapper .LowerRightBox { float: left; padding-left: 10px; width: 190px; padding-top: 15px; }

.SignupWrapper .UpperRightBox { border-bottom: 1px solid rgb(204, 204, 204); float: left; width: 175px; height: 36px; padding-right: 30px; padding-left: 10px; margin-top: 25px; padding-top: 10px; }

.SignupWrapper .loginLink { background: url("/web/20130528173607im_/https://www.roblox.com/images/UI/btn-login-gray-small.png") left top; width: 51px; height: 23px; cursor: pointer; float: right; }

.SignupWrapper .fbLoginButton { background: url("/web/20130528173607im_/https://www.roblox.com/images/UI/btn-login_with_fb.png") left top; width: 170px; height: 25px; cursor: pointer; display: block; text-align: center; margin-top: 10px; }

.SignupWrapper .signupMainButton { background: url("/web/20130528173607im_/https://www.roblox.com/images/UI/btn-sign_up-mainpage.png") left top; width: 119px; height: 50px; cursor: pointer; display: block; margin: 0px auto; }

.SignupWrapper .submitMainButton { background: url("/web/20130528173607im_/https://www.roblox.com/images/UI/btn-submit.png") left top; width: 134px; height: 50px; cursor: pointer; display: block; margin: 0px auto; }

.SignupWrapper .signupMainButton:hover, .SignupWrapper .fbLoginButton:hover, .SignupWrapper .loginLink:hover, .SignupWrapper .submitMainButton:hover { background-position: left bottom; }

.SignupWrapper .Termsandconditions { padding-top: 20px; font-size: 11px; padding-bottom: 7px; }

div.SignupWrapper div.rightFormColumn { float: left; width: 350px; }

div.SignupWrapper .inputColumn { float: left; width: 183px; text-align: left; }

div.SignupWrapper .formRadio { float: left; width: 132px; text-align: left; }

div.SignupWrapper .formRow { float: left; padding: 2px 0px 14px 23px; }

div.SignupWrapper .formRow label, div.NewEmailForm .formRow span.FormTitle { float: left; padding: 0px; width: 140px; text-align: left; margin-top: 4px; }

div.SignupWrapper .formRow input { width: 170px; float: left; }

div.SignupWrapper .formRow select { float: left; margin-left: 0px; }

div.SignupWrapper .formRadio label { width: auto; float: none; font-size: 12px; font-weight: normal; }

div.SignupWrapper .formSelect { float: left; text-align: left; }

input#MaleBtn { margin-left: 0px; }

input#FemaleBtn { margin-left: 20px; }

