.subMenu { background: repeat-x rgb(163, 81, 79); color: white; font-family: Arial, Helvetica, sans-serif; font-size: 14px; height: 26px; position: relative; border-left: 3px solid rgb(110, 153, 201); border-right: 3px solid rgb(110, 153, 201); border-bottom: 3px solid rgb(110, 153, 201); z-index: 5; }

