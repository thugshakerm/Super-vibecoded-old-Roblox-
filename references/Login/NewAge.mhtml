#Footer.LanguageRedesign a, #Footer.LanguageRedesign a, #Footer.LanguageRedesign a, #Footer.LanguageRedesign .FooterNav { color: white; font-family: Arial, Helvetica, sans-serif; }

#Footer.LanguageRedesign .FooterNav { width: 970px; margin: 0px auto; }

