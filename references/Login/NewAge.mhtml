.BigButtonDisabled { background-color: rgb(192, 192, 192); color: rgb(0, 0, 0); height: 2.5em; font-family: Verdana, Helvetica, sans-serif; font-size: 20px; font-weight: bold; }

.ErrorReporting, .ErrorReportingThanks { width: 500px; margin: 16px auto; padding: 10px; }

.YesNoButtons { text-align: right; }

.YesButton, .NoButton { background-color: rgb(245, 205, 47); color: rgb(0, 0, 0); margin-left: 10px; }

