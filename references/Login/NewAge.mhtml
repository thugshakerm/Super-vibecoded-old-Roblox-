.Column2a { float: left; }

.Column3b { float: left; }

.Column2c { float: left; margin-left: 10px; }

.Column2d { float: left; }

.Column1e { width: 150px; }

.Column2e .StandardBoxHeaderGray { margin: 0px; width: 726px; }

.Column2e .StandardBoxGray { width: 726px; }

div.rbx2only { display: block; }

.rbx2only { display: inline; }

.rbx2hide { display: none; }

