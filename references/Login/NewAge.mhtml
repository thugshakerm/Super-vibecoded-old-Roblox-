.FriendRequestsPane { width: 890px; }

.Shadow { display: none; }

.ShadowedStandardBox .Header { height: 33px; padding: 0px 7px 0px 5px; text-align: left; z-index: 2; background: url("/web/20130428094206im_/https://www.roblox.com/images/cssspecific/rbx2/tab_black_33h_t1.png") left top no-repeat; font-family: Arial, Helvetica, sans-serif; font-size: 20px; font-weight: bold; color: rgb(255, 255, 255); }

