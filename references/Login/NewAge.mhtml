.ColorPickerItem { border-color: rgb(255, 255, 255); border-style: solid; border-width: 2px; }

.ColorPickerItem:hover { border-color: rgb(225, 225, 225); border-style: solid; border-width: 2px; }

.ColorPickerModal { display: none; border-color: rgb(136, 136, 136); }

.ColorPickerContainer { height: 368px; width: 368px; margin: 0px auto; }

