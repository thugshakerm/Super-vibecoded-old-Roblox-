#Banner #Options #Settings { bottom: 0px; left: 0px; padding: 4px; position: absolute; }

#Banner #Logo { height: 34px; left: 0px; position: absolute; top: 5px; width: 140px; margin: 0px; float: none; background: url("/web/20130428094206im_/https://www.roblox.com/images/cssthemes/base/img-robloxlogo.png") no-repeat; }

#SmallHeaderContainer #Banner #Alerts { background: transparent; border: none; position: relative; width: 350px; height: 40px; float: right; padding-top: 9px; }

#HeaderContainer #Banner #Alerts { float: right; border: 1px solid rgb(110, 153, 201); background: rgb(255, 255, 255); width: 203px; }

#Header .Navigation { clear: both; background-color: rgb(110, 153, 201); color: rgb(255, 255, 255); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-weight: normal; line-height: 2em; text-decoration: none; }

#AdvertisingLeaderboard { margin: 0px auto 10px; text-align: center; padding-top: 5px; width: 875px; }

