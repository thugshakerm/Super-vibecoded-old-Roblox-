@charset "utf-8";

div#navigation-menu { display: inline-block; min-height: 36px; z-index: 1000; float: left; color: rgb(255, 255, 255); text-decoration: none; height: 30px; text-align: left; line-height: 20px; }

#navigation-container { text-align: left; position: relative; height: 36px; z-index: 200; min-width: 970px; display: table; margin-left: auto; margin-right: auto; }

#navigation-menu ul { margin: 0px auto; padding: 0px; }

#navigation-menu li { float: left; list-style: none; margin: 0px; padding: 7px 7px 0px; height: 28px; cursor: pointer; }

#navigation-menu li:hover, #navigation-container #AuthenticatedUserNameWrapper:hover { background: url("/web/20131205145249im_/https://www.roblox.com/images/RevisedHeader/bg-main_menu_hover.png") repeat-x; }

#navigation-container #AuthenticatedUserNameWrapper { min-height: 30px; width: auto; cursor: pointer; float: right; padding: 5px 5px 0px; margin-top: -10px; }

#navigation-menu a { display: inline-block; color: rgb(255, 255, 255); }

#navigation-container a:hover { text-decoration: none; }

#navigation-container ul li a, #navigation-menu ul li a:visited { border: 0px solid black; padding: 0px; text-decoration: none; outline: none; font-size: 15px; font-weight: 600; }

#navigation-container span.login-span { top: 0px; max-width: 110px; white-space: nowrap; font-size: 12px; }

#navigation-container img#over13icon { top: 1px; }

#navigation-container a.btn-logo, #navigation-menu a.btn-logo:visited, #navigation-container a.btn-logo:hover { background: url("/web/20131205145249im_/https://www.roblox.com/images/RevisedHeader/btn-rbx_logo.png") center top no-repeat; display: inline-block; width: 116px; height: 35px; float: left; margin-right: 4px; }

#navigation-container a.btn-logo:hover { background-position: center bottom; }

#navigation-container #AuthenticatedUserName { display: inline-block; color: rgb(255, 255, 255); font-size: 11px; margin-top: 5px; max-width: 145px; overflow: hidden; font-weight: normal; }

.site-header { background: url("/web/20131205145249im_/https://www.roblox.com/images/RevisedHeader/bg-rbx_header.png") repeat-x rgb(17, 64, 129); height: 36px; position: fixed; width: 100%; z-index: 10001; top: 0px; }

.site-header.unfixed { position: relative; }

#navigation-container #AlertSpace { background: none; display: inline-block; float: right; height: 20px; margin-top: 10px; }

#navigation-container .iframe-login-signup { margin-top: 4px; }

#navigation-container #header-login-container { display: inline; }

#navigation-container .AlertItem { float: right; margin-top: -10px; padding: 10px 4px 0px; cursor: pointer; min-height: 25px; }

#navigation-container .AlertItem .friends_icon, #navigation-container .AlertItem .message_icon { float: right; }

#navigation-container .AlertItem a { color: white; }

#navigation-container #Alerts { margin-top: -20px; }

#navigation-container .message_icon { background: url("/web/20131205145249im_/https://www.roblox.com/images/RevisedHeader/bg-icon_sprites.png") center top; }

#navigation-container .MessageAlert:hover .message_icon { background: url("/web/20131205145249im_/https://www.roblox.com/images/RevisedHeader/bg-icon_sprites.png") 0px -20px; }

#navigation-container .friends_icon { background: url("/web/20131205145249im_/https://www.roblox.com/images/RevisedHeader/bg-icon_sprites.png") 0px 160px; }

#navigation-container .FriendsAlert:hover .friends_icon { background: url("/web/20131205145249im_/https://www.roblox.com/images/RevisedHeader/bg-icon_sprites.png") 0px 140px; }

#navigation-container .AlertItem:hover { background: url("/web/20131205145249im_/https://www.roblox.com/images/RevisedHeader/bg-main_menu_hover.png") repeat-x; }

#navigation-container .robux_icon { background: url("/web/20131205145249im_/https://www.roblox.com/images/RevisedHeader/bg-icon_sprites.png") 0px 120px; }

#navigation-container .RobuxAlert:hover .robux_icon { background: url("/web/20131205145249im_/https://www.roblox.com/images/RevisedHeader/bg-icon_sprites.png") 0px 100px; }

#navigation-container div.tickets_icon { background: url("/web/20131205145249im_/https://www.roblox.com/images/RevisedHeader/bg-icon_sprites.png") 0px 80px; margin-left: 0px; }

#navigation-container .TicketsAlert:hover .tickets_icon { background: url("/web/20131205145249im_/https://www.roblox.com/images/RevisedHeader/bg-icon_sprites.png") 0px 60px; }

#navigation-container .icons { height: 20px; width: 20px; float: left; margin: -3px 2px -15px; }

#navigation-container .MessageAlertCaption { float: left; }

#navigation-container #SettingsButton { background: url("/web/20131205145249im_/https://www.roblox.com/images/RevisedHeader/bg-icon_sprites.png") 0px 40px; height: 19px; width: 20px; float: right; margin-top: -2px; cursor: pointer; }

#navigation-container .HeaderDivider { margin: -5px 4px 0px; float: right; height: 25px; width: 0px; border-left: 1px solid rgb(115, 148, 193); }

.more-list-item { cursor: pointer; width: 43px; text-decoration: none; outline: none; }

#navigation-menu li.more-list-item { background: none; }

.more-list-item .more-link-container { height: 35px; top: -8px; position: relative; }

#nav-more { margin-top: 8px; text-decoration: none; white-space: nowrap; }

.more-list-item.active #nav-more { color: black; margin-top: 0px; background-color: rgb(239, 239, 239); }

.more-list-item span#more-menu-toggle, .more-list-item span#more-menu-toggle:hover { text-decoration: none; outline: none; padding: 0px 2px; cursor: pointer; border: none; background: url("/web/20131205145249im_/https://www.roblox.com/images/Buttons/bg-drop_down_arrow.png") center top no-repeat; height: 5px; width: 7px; display: inline-block; margin-left: 2px; top: -1px; position: relative; }

.more-list-item.active span#more-menu-toggle, .more-list-item.active span#more-menu-toggle:hover { background: url("/web/20131205145249im_/https://www.roblox.com/images/Buttons/bg-drop_down_arrow.png") center bottom no-repeat; top: -1px; }

#navigation-menu .dropdownnavcontainer { margin-top: -8px; margin-left: -8px; color: black; min-height: 100px; }

.dropdownnavcontainer .dropdownoption { position: relative; cursor: pointer; }

.dropdownnavcontainer .dropdownoption img { border: none; }

#navigation-menu .dropdownmainnav { background-color: rgb(239, 239, 239); border: 1px solid rgb(119, 119, 119); display: inline-block; zoom: 1; }

#navigation-menu .dropdownmainnav a { color: black; font-size: 13px; line-height: 23px; display: block; }

#navigation-menu .dropdownnavcontainer a:hover { background-color: rgb(216, 216, 216); }

#navigation-menu .more-list-item.active:hover .more-link-container, #navigation-menu li.more-list-item.active .more-link-container { background-color: rgb(239, 239, 239); border-top: 1px solid rgb(119, 119, 119); border-right: 1px solid rgb(119, 119, 119); border-left: 1px solid rgb(119, 119, 119); border-image: initial; border-bottom: none; background-image: none; height: 35px; top: -7px; line-height: 33px; left: -8px; position: relative; padding: 0px 5px 0px 7px; display: inline-block; }

#navigation-container .settingsnavcontainer { position: absolute; background-color: rgb(239, 239, 239); border: 1px solid rgb(119, 119, 119); color: black; width: 115px; height: 52px; right: 0px; top: 35px; z-index: -1; line-height: 23px; }

#navigation-container .AlertBox { background: url("/web/20131205145249im_/https://www.roblox.com/images/RevisedHeader/bg-alerts-v2.png") left center no-repeat; float: left; height: 11px; font: bold 10px Arial, Helvetica, sans-serif; }

#navigation-container .AlertBox.Left { width: 3px; height: 11px; background-position: left center; }

#navigation-container .AlertBox.Right { background-position: right center; padding-right: 3px; }

.AlertItem .AlertTextWrapper { margin-left: 17px; }

#navigation-container .AlertCaption { text-align: center; float: left; color: white; font-weight: normal; font-size: 11px; }

.subMenu { background: rgb(25, 25, 25); border: none; color: white; height: 25px; margin: 0px auto; position: relative; text-align: center; width: 970px; z-index: 200; }

.subMenu ul { list-style-type: none; margin: 0px 0px 0px 10px; padding: 0px; }

.subMenu ul li { float: left; height: 30px; margin: 0px 2px; position: relative; }

.subMenu ul li:hover { background: url("/web/20131205145249im_/https://www.roblox.com/images/RevisedHeader/bg-sub_menu_hover.png") 0px 30px repeat-x; }

.subMenu a, .subMenu a:visited { border: none; color: rgb(255, 255, 255); display: block; padding: 5px; }

.subMenu a:hover { text-decoration: none; }

.dropdownmainnav .dropdownoption span { margin-left: 1px; font-weight: normal; padding: 1px 10px 1px 5px; }

#navigation-container .AlertText { height: 7px; margin-top: 2px; color: black; line-height: 7px; }

.mySubmenuFixed.Redesign { position: fixed; top: 35px; }

#navigation-container .logoutButton { display: inline-block; font-size: 11px; color: white; float: right; position: relative; bottom: 2px; }

div.mySubmenuFixed { top: 36px; background-color: rgb(25, 25, 25); height: 25px; }

.login-span { top: 17px; position: relative; float: left; }

.login-span a { color: white; }

body.banner { background-color: transparent; }

.ad-annotations { width: 100%; height: 11px; position: relative; margin: 0px auto; font-size: 11px; z-index: 100; }

.ad-identification { position: absolute; left: 0px; }

.dark-theme-ad-annotation, .dark-theme-ad-annotation .BadAdButton:link { color: rgb(255, 255, 255); }

.BadAdButton { position: absolute; right: 0px; }

.BadAdButton:link { color: rgb(128, 172, 230); }

.Ads_WideSkyscraper { float: right; text-align: right; width: 160px; }

#AdvertisingLeaderboard { margin: 0px auto 10px; text-align: center; padding-top: 5px; width: 728px; }

.GPTAd.banner { width: 745px; height: 90px; }

.GPTAd.skyscraper { width: 160px; height: 600px; display: block; }

.GPTAd.rectangle { width: 300px; height: 250px; }

.GPTAd.narrowskyscraper { width: 600px; }

.GPTAd.gutter { width: 400px; height: 1180px; }

.GPTAd.opapushdown { width: 970px; height: 96px; }

.GPTAd { overflow: hidden; margin: 0px auto; }

div.SignupWrapper .inputColumn.radio { width: auto; }

.SignupWrapper div.validation { height: 14px; margin-top: 5px; float: left; position: relative; }

table { border-collapse: collapse; }

table td, table th { padding: 0px; }

table#UsernameError { left: -2px; top: -17px; display: none; }

.SignupWrapper table#birthdayError { display: none; left: 2px; top: -5px; }

.SignupWrapper #genderError { display: none; height: 0px; top: -3px; }

table#passwordError { left: -2px; top: -17px; display: none; }

table#passwordConfirmError { left: -2px; top: -17px; display: none; }

div.LowerRightBox span { font-size: 15px; font-weight: bold; color: rgb(54, 54, 54); }

div.clear { clear: both; }

input[type="radio"]#MaleBtn, input[type="radio"]#FemaleBtn { padding: 0px; margin-top: -3px; vertical-align: middle; margin-right: 2px; }

div.formRadio.signupPage { margin-top: 5px; width: 150px; }

div#genderGood { margin: 0px; }
