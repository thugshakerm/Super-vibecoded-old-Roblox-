@page "/Login/Signup.aspx"
@model Roblox.Website.Pages.Login.SignupModel
@{ ViewData["Title"] = "ROBLOX.com"; }
<div class="SignupWrapper">
    <div class="title"><h1>Sign up to build &amp; make friends</h1></div>
    <div class="SignupBox divider-right">
        <form method="post">
            <div class="formRow">
                <label class="form-label" for="lstMonths">Birthday</label>
                <div class="rightFormColumn">
                    <div class="inputColumn radio">
                        <select asp-for="Input.BirthMonth" id="lstMonths" tabindex="1" class="form-select"><option value="">Month</option>@for (var month=1;month<=12;month++){<option value="@month">@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetAbbreviatedMonthName(month)</option>}</select>
                        <select asp-for="Input.BirthDay" id="lstDays" tabindex="2" class="form-select"><option value="">Day</option>@for(var day=1;day<=31;day++){<option value="@day">@day</option>}</select>
                        <select asp-for="Input.BirthYear" id="lstYears" tabindex="3" class="form-select" style="margin:0;"><option value="">Year</option>@for(var year=DateTime.UtcNow.Year;year>=1913;year--){<option value="@year">@year</option>}</select>
                    </div>
                    <div class="validation"><table id="birthdayError" class="validator-container" style="@(Model.ErrorMessage is not null ? "display:table" : "")"><tr><td><div class="validator-tooltip-top"></div><div class="validator-tooltip-main"><p>Invalid birthday</p></div><div class="validator-tooltip-bottom"></div></td></tr></table><div id="birthdayGood" class="validator-checkmark"></div></div>
                    <div class="clear" style="font-size:0;"></div><span class="tip-text">Enter your birthday for a personalized experience.<br/>It will not be given to any third party.</span>
                </div>
            </div>
            <div class="formRow"><label class="form-label" for="MaleBtn">Gender:</label><div class="formRadio signupPage"><input asp-for="Input.Gender" id="MaleBtn" type="radio" value="Male" tabindex="4"/><label for="MaleBtn">Male</label><input asp-for="Input.Gender" id="FemaleBtn" type="radio" value="Female" tabindex="5"/><label for="FemaleBtn">Female</label></div><div class="validation"><div id="genderError" class="validator-container" style="position:absolute;@(Model.ErrorMessage is not null ? "display:block" : "")"><div class="validator-tooltip-top"></div><div class="validator-tooltip-main"><p>Required field</p></div><div class="validator-tooltip-bottom"></div></div><div id="genderGood" class="validator-checkmark"></div></div></div>
            <div class="formRow"><label class="form-label" for="UserName">Desired Username:</label><div class="rightFormColumn"><div class="inputColumn"><input asp-for="Input.Username" id="UserName" tabindex="6" class="text-box text-box-large" autocomplete="username"/></div><div class="validation"><table id="UsernameError" class="validator-container" style="@(Model.ErrorMessage is not null ? "display:table" : "")"><tr><td><div class="validator-tooltip-top"></div><div class="validator-tooltip-main"><div id="usernameErrorMessage">@Model.ErrorMessage</div></div><div class="validator-tooltip-bottom"></div></td></tr></table><div id="usernameGood" class="validator-checkmark"></div></div><div class="clear" style="font-size:0;"></div><span class="tip-text">3-20 alphanumeric characters, no spaces.<br/>Do not use your real name.</span></div></div>
            <div class="formRow"><label class="form-label" for="Password">Password:</label><div class="rightFormColumn"><div class="inputColumn"><input asp-for="Input.Password" id="Password" tabindex="7" class="text-box text-box-large" type="password" autocomplete="new-password"/></div><div class="validation"><table id="passwordError" class="validator-container" style="@(Model.ErrorMessage is not null ? "display:table" : "")"><tr><td><div class="validator-tooltip-top"></div><div class="validator-tooltip-main"><div id="passwordErrorMessage">@Model.ErrorMessage</div></div><div class="validator-tooltip-bottom"></div></td></tr></table><div id="passwordGood" class="validator-checkmark"></div></div><div class="clear" style="font-size:0;"></div><span class="tip-text">6-20 characters, minimum of 4 letters &amp; 2 numbers</span></div></div>
            <div class="formRow"><label class="form-label" for="PasswordConfirm">Confirm Password:</label><div class="inputColumn"><input asp-for="Input.ConfirmPassword" id="PasswordConfirm" tabindex="8" class="text-box text-box-large" type="password" autocomplete="new-password"/></div><div class="validation"><table id="passwordConfirmError" class="validator-container" style="@(Model.ErrorMessage is not null ? "display:table" : "")"><tr><td><div class="validator-tooltip-top"></div><div class="validator-tooltip-main"><div id="PasswordConfirmMessage">@Model.ErrorMessage</div></div><div class="validator-tooltip-bottom"></div></td></tr></table><div id="passwordConfirmGood" class="validator-checkmark"></div></div></div>
            <div class="clear" style="font-size:0;"></div><div class="CreateAccountWrapper" style="text-align:center"><button type="submit" data-se="SignUpButton" class="btn-large btn-primary">Sign Up<span class="btn-text">Sign Up</span></button></div>
        </form>
    </div>
    <div class="UpperRightBox divider-bottom"><span style="margin-top:5px;float:left;">Already registered?</span><a href="/Login/Default.aspx" class="btn-small btn-negative" style="margin-left:5px;">Login<span class="btn-text">Login</span></a></div>
    <div class="LowerRightBox"><div class="Termsandconditions">By clicking Sign Up, you agree to our <a href="/info/terms-of-service" target="_blank">Terms of Service</a>, <a href="/Info/EULA.htm" target="_blank">Licensing Agreement</a>, and <a href="/Info/Privacy.aspx" target="_blank">Privacy Policy</a>. We will not share your information with 3rd parties.</div></div>
</div>
