@page "/Login/Signup.aspx"
@model Roblox.Website.Pages.Login.SignupModel
@{
    ViewData["Title"] = "ROBLOX.com";
}
<div id="SignupContainer" class="SignupContainer">
    <h1>Sign up to build &amp; make friends</h1>
    <form method="post">
        <div><label>Birthday</label><select asp-for="Input.BirthMonth"><option value="">Month</option>@for (var month = 1; month <= 12; month++) { <option value="@month">@month</option> }</select><select asp-for="Input.BirthDay"><option value="">Day</option>@for (var day = 1; day <= 31; day++) { <option value="@day">@day</option> }</select><select asp-for="Input.BirthYear"><option value="">Year</option>@for (var year = DateTime.UtcNow.Year; year >= 1913; year--) { <option value="@year">@year</option> }</select><p>Enter your birthday for a personalized experience. It will not be given to any third party.</p></div>
        <div><label>Gender:</label><input asp-for="Input.Gender" type="radio" value="Male" />Male<input asp-for="Input.Gender" type="radio" value="Female" />Female</div>
        <div><label>Desired Username:</label><input asp-for="Input.Username" autocomplete="username" /><p>3-20 alphanumeric characters, no spaces.</p><p>Do not use your real name.</p></div>
        <div><label>Password:</label><input asp-for="Input.Password" type="password" autocomplete="new-password" /><p>6-20 characters, minimum of 4 letters &amp; 2 numbers</p></div>
        <div><label>Confirm Password:</label><input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" /></div>
        <button type="submit">Sign Up</button>
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="error-message">@Model.ErrorMessage</div> }
    </form>
    <p>Already registered? <a href="/Login/Default.aspx">Login</a></p>
    <p>By clicking Sign Up, you agree to our <a href="/info/terms-of-service">Terms of Service</a>, <a href="/Info/EULA.htm">Licensing Agreement</a>, and <a href="/Info/Privacy.aspx">Privacy Policy</a>.</p>
</div>
