@page "/Login/Signup.aspx"
@model Roblox.Website.Pages.Login.SignupModel
@{ ViewData["Title"] = "ROBLOX.com"; }
<div class="SignupWrapper"><div class="title"><h1>Sign up to build &amp; make friends</h1></div>
<div class="SignupBox divider-right"><form method="post">
<div class="formRow"><label class="form-label">Birthday</label><div class="rightFormColumn"><div class="inputColumn radio"><select asp-for="Input.BirthMonth" class="form-select"><option value="">Month</option>@for(var i=1;i<=12;i++){<option value="@i">@i</option>}</select><select asp-for="Input.BirthDay" class="form-select"><option value="">Day</option>@for(var i=1;i<=31;i++){<option value="@i">@i</option>}</select><select asp-for="Input.BirthYear" class="form-select"><option value="">Year</option>@for(var i=DateTime.UtcNow.Year;i>=1913;i--){<option value="@i">@i</option>}</select></div><div class="clear"></div><span class="tip-text">Enter your birthday for a personalized experience.<br/>It will not be given to any third party.</span></div></div>
<div class="formRow"><label class="form-label">Gender:</label><div class="formRadio signupPage"><input asp-for="Input.Gender" type="radio" value="Male"/> Male <input asp-for="Input.Gender" type="radio" value="Female"/> Female</div></div>
<div class="formRow"><label class="form-label" asp-for="Input.Username">Desired Username:</label><div class="rightFormColumn"><div class="inputColumn"><input asp-for="Input.Username" class="text-box text-box-large" autocomplete="username"/></div><div class="clear"></div><span class="tip-text">3-20 alphanumeric characters, no spaces.<br/>Do not use your real name.</span></div></div>
<div class="formRow"><label class="form-label" asp-for="Input.Password">Password:</label><div class="rightFormColumn"><div class="inputColumn"><input asp-for="Input.Password" class="text-box text-box-large" type="password" autocomplete="new-password"/></div><div class="clear"></div><span class="tip-text">6-20 characters, minimum of 4 letters &amp; 2 numbers</span></div></div>
<div class="formRow"><label class="form-label" asp-for="Input.ConfirmPassword">Confirm Password:</label><div class="inputColumn"><input asp-for="Input.ConfirmPassword" class="text-box text-box-large" type="password" autocomplete="new-password"/></div></div><div class="clear"></div><div class="CreateAccountWrapper" style="text-align:center"><button type="submit" class="btn-large btn-primary">Sign Up</button></div>@if(!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="validation-summary-errors">@Model.ErrorMessage</div>}</form></div>
<div class="UpperRightBox divider-bottom"><span style="margin-top:5px;float:left;">Already registered?</span><a href="/Login/Default.aspx" class="btn-small btn-negative" style="margin-left:5px;">Login<span class="btn-text">Login</span></a></div><div class="LowerRightBox"><div class="Termsandconditions">By clicking Sign Up, you agree to our <a href="/info/terms-of-service">Terms of Service</a>, <a href="/Info/EULA.htm">Licensing Agreement</a>, and <a href="/Info/Privacy.aspx">Privacy Policy</a>. We will not share your information with 3rd parties.</div></div></div>
