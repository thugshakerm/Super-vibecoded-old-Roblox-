@page "/Login/Default.aspx"
@model Roblox.Website.Pages.Login.DefaultModel
@{ ViewData["Title"] = "ROBLOX Login"; }
<div class="LoginNewStyle">
    <div class="MyRobloxContainer">
        <div style="clear:both;"></div>
        <div class="Column1a">
            <div class="StandardBoxHeader" id="newLoginHeader" style="width:300px;"><span>Login</span></div>
            <div class="StandardBox" id="newLogin" style="height:170px;width:300px;">
                <form method="post" class="AspNet-Login">
                    <table style="margin:0 auto;"><tbody>
                        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <tr><td colspan="2" style="color:#FF0000">@Model.ErrorMessage</td></tr> }
                        <tr><td style="text-align:right;">Username:</td><td><div><input asp-for="Input.Username" id="ctl00_cphRoblox_lRobloxLogin_UserName" class="TextBox" style="border:2px solid #CCCCCC;width:130px;" autocomplete="username"></div></td></tr>
                        <tr><td style="text-align:right;">Password:</td><td style="position:relative;display:block;"><div style="float:left;width:215px;"><div><input asp-for="Input.Password" id="ctl00_cphRoblox_lRobloxLogin_Password" class="TextBox" style="border:2px solid #CCCCCC;width:130px;" type="password" autocomplete="current-password"></div></div><div style="position:absolute;top:2px;left:150px;"><input type="submit" value="Login" class="MediumButton translate"></div></td></tr>
                        <tr><td colspan="2" align="center" style="padding-bottom:10px;"><div style="font-size:11px;"><a href="/Login/ResetPasswordRequest.aspx">Forgot your password?</a></div></td></tr>
                    </tbody></table>
                </form>
            </div>
        </div>
        <div class="Column2a">
            <div class="StandardBoxHeader" style="width:558px;float:right;"><span>Create a Free ROBLOX Account</span></div>
            <div class="StandardBox" id="newSignupBox" style="width:558px;float:right;min-height:170px;"><div id="ChooseBirthdate" style="height:111px;"><p>Creating an account on ROBLOX allows you to customize your character, make friends, build places, earn money, and more!</p><form method="get" action="/Login/Signup.aspx"><center><span>Your Date of Birth: </span><select name="BirthMonth"><option value="">Select Month</option>@for (var month = 1; month <= 12; month++) { <option value="@month">@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(month)</option> }</select><select name="BirthDay"><option value="">Select Day</option>@for (var day = 1; day <= 31; day++) { <option value="@day">@day</option> }</select><select name="BirthYear"><option value="">Select Year</option>@for (var year = DateTime.UtcNow.Year; year >= 1913; year--) { <option value="@year">@year</option> }</select>&nbsp;&nbsp;<button type="submit" id="btnContinue" class="MediumButton translate">Continue</button><div style="font-style:italic;margin-top:15px;">Your birthday will not be given out to any third party!</div></center></form></div></div>
        </div>
        <div style="clear:both;"></div>
        <div id="ExpandBorder" style="float:right;width:568px;height:40px;border:1px solid #AAAAAA;border-top:none;margin-top:-49px">&nbsp;</div>
        <div class="Column1a"><div class="StandardBoxHeader" style="width:300px;"><span>You don't need an account to play ROBLOX</span></div><div class="StandardBox" style="width:300px;text-align:center;"><p>You can start playing right now, in guest mode! Just click on the game you want to play.</p><a href="/Games.aspx" class="MediumButton" style="text-decoration:none;color:#222222;width:20%;">Play as Guest</a><p></p></div></div>
        <div style="clear:both;"></div>
    </div>
</div>
