@charset "utf-8";

body { font: 8pt Verdana, sans-serif; margin: 0px; text-transform: none; text-decoration: none; background: url("/web/20120402103557im_/http://www.roblox.com/images/bg_gradient.jpg") repeat-x rgb(248, 252, 255); }

a { text-decoration: none; }

a img { border: none; }

a:link, a:visited, a:active { color: rgb(9, 95, 181); }

a:hover { text-decoration: underline; }

abbr, acronym { cursor: help; border-bottom: 1px dotted rgb(0, 0, 0); }

h1, h2, h3, h4, h5, h6 { margin: 0px; padding: 0px; font-size: 100%; font-weight: inherit; display: inline-block; }

pre { white-space: pre-wrap; overflow-wrap: break-word; }

input.Text { border-color: rgb(119, 119, 119); border-style: dashed; }

.AdminPanel { border-color: orange; border-style: dotted; padding: 10px; }

.ImageButton { cursor: pointer; padding: 0px; border: 0px; text-decoration: none; margin: 0px; display: inline-block; }

.Button { cursor: pointer; background-color: rgb(255, 255, 255); border: 1px solid rgb(51, 51, 51); color: rgb(51, 51, 51); font-family: Verdana, sans-serif; font-size: 0.9em; padding: 3px 10px; text-decoration: none; }

.Button:link, .Button:visited { border: 1px solid rgb(119, 119, 119); color: rgb(119, 119, 119); }

.Button:hover, .Button:active { background-color: rgb(110, 153, 201); border: 1px solid rgb(0, 0, 0); color: rgb(255, 255, 255); }

.Bullet { float: left; margin-right: 10px; margin-bottom: 4px; }

.Ads_RightSidebar { border: 1px solid rgb(0, 0, 0); float: right; text-align: right; width: 160px; }

.Legalese { font-size: 7pt; }

#Container { margin: 0px auto; padding: 0px 10px; border-left: 5px solid rgb(221, 221, 221); border-right: 5px solid rgb(221, 221, 221); width: 900px; background: rgb(229, 241, 253); }

#Header { margin: 0px auto; color: white; font: bold 12px Verdana, sans-serif; width: 900px; text-align: center; }

#Header a, #Header a:visited, #Header a:active { text-decoration: none; }

#Header a:hover { text-decoration: underline; }

#HeaderContainer #Banner { background-image: url("/web/20120402103557im_/http://www.roblox.com/images/WoodBanner.png"); background-repeat: no-repeat; height: 72px; text-align: center; }

#SmallHeaderContainer #Banner { height: 50px; background: none; position: relative; bottom: 0px; }

.loginSpan { float: left; }

#Banner #Options { float: left; height: 72px; position: relative; overflow: hidden; width: 200px; }

#Banner #Authentication { top: 0px; left: 0px; padding: 4px; position: absolute; background: rgb(110, 153, 201); }

#Banner #AuthenticatedUserName { float: left; position: relative; top: 20px; height: 28px; font-family: Arial; font-size: 11px; font-weight: normal; color: black; background: none; left: 145px; }

#Banner #AuthenticationButton { position: relative; top: 0px; height: 40px; font-weight: normal; float: right; z-index: 1; margin-top: 10px; left: 340px; }

#Banner #AuthenticationButton a { background: url("/web/20120402103557im_/http://www.roblox.com/images/cssthemes/base/btn_blue.png") 0px 0px repeat-x scroll transparent; font-weight: bold; color: white; font-family: Arial; font-size: 10px; height: 16px; display: block; padding-top: 1px; text-align: center; width: 40px; margin-top: 1px; margin-left: 5px; }

#Banner #Options #Settings { bottom: 0px; left: 0px; padding: 4px; position: absolute; }

#Banner #Logo { height: 34px; left: 0px; position: absolute; top: 5px; width: 140px; margin: 0px; float: none; background: url("/web/20120402103557im_/http://www.roblox.com/images/cssthemes/base/img-robloxlogo.png") no-repeat; }

#SmallHeaderContainer #Banner #Alerts { background: transparent; border: none; position: relative; width: 350px; height: 40px; float: right; padding-top: 9px; }

#HeaderContainer #Banner #Alerts { float: right; border: 1px solid rgb(110, 153, 201); background: rgb(255, 255, 255); width: 203px; }

#Header .Navigation { clear: both; background-color: rgb(110, 153, 201); color: rgb(255, 255, 255); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-weight: normal; line-height: 2em; text-decoration: none; }

#AdvertisingLeaderboard { margin: 0px auto 5px; text-align: center; width: 898px; }

#AdvertisingSkyscraper { border: 1px solid rgb(0, 0, 0); float: right; text-align: right; width: 120px; }

#RobloxLargeRectangleAd { padding: 10px 0px; }

#MasterContainer { background: url("/web/20120402103557im_/http://www.roblox.com/images/bg_clouds.jpg") center top no-repeat scroll transparent; width: 100%; overflow: auto; }

#Body { width: 900px; overflow: hidden; }

#Footer { font: 13px Verdana, sans-serif; padding: 3em 20px; width: 860px; text-align: center; margin: 0px; }

#Footer .SEOGenreLinks { padding: 1em 0px 2em; font-size: 11px; }

#Footer .Legalese { color: rgb(85, 85, 85); font-size: 10px; margin-bottom: 1em; }

.AdmiPanel { border: 1px solid rgb(0, 0, 0); bottom: 20px; height: 250px; overflow: hidden; right: 10px; padding-top: 15px; position: fixed; width: 200px; }

.AdmiPanel h4 { background-color: rgb(204, 204, 204); border-bottom: 1px solid rgb(0, 0, 0); color: rgb(51, 51, 51); margin: 0px; text-align: center; }

.AdmiPanelExpandCollapse { color: green; cursor: pointer; font-weight: bolder; position: absolute; right: 2px; top: 2px; }

.Panel { border: 1px solid rgb(0, 0, 0); }

.Panel h4 { background-color: rgb(204, 204, 204); border-bottom: 1px solid rgb(0, 0, 0); color: rgb(51, 51, 51); margin: 0px; text-align: center; }

.MultilineTextBox { border: 2px dashed gray; font-family: Verdana, sans-serif; font-size: 1.2em; line-height: 1.5em; padding: 5px; }

.TextBox { border: 1px solid rgb(204, 204, 204); font-family: Verdana, sans-serif; font-size: 1.2em; padding: 5px; }

.Label { font-weight: bold; }

.BigButton { background-color: rgb(245, 205, 47); color: rgb(0, 0, 0); height: 2.5em; font-family: Verdana, Helvetica, sans-serif; font-size: 20px; font-weight: bold; }

.BigButtonDisabled { background-color: rgb(192, 192, 192); color: rgb(0, 0, 0); height: 2.5em; font-family: Verdana, Helvetica, sans-serif; font-size: 20px; font-weight: bold; }

.ErrorReporting, .ErrorReportingThanks { width: 500px; margin: 16px auto; padding: 10px; }

.YesNoButtons { text-align: right; }

.YesButton, .NoButton { background-color: rgb(245, 205, 47); color: rgb(0, 0, 0); margin-left: 10px; }

.popupControl { background-color: rgb(255, 255, 255); border: 1px outset rgb(255, 255, 255); position: absolute; visibility: hidden; z-index: 1; }

.ColorPickerItem { border-color: rgb(255, 255, 255); border-style: solid; border-width: 2px; }

.ColorPickerItem:hover { border-color: blue; border-style: solid; border-width: 2px; }

.modalBackground { background-color: gray; opacity: 0.3; }

.modalPopup { background-color: rgb(255, 255, 221); border-width: 3px; border-style: solid; border-color: gray; padding: 3px; }

.newModalPopup { padding: 3px; }

.GuestModePromptText { font-size: 14px; color: rgb(51, 51, 51); margin-left: 30px; }

.GuestModePromptText li { font-weight: bolder; }

.PopupMenu { background-color: rgb(255, 255, 255); border: 1px solid rgb(102, 102, 102); padding: 10px; z-index: 1; }

.PopupMenu .Button { line-height: 2.5em; }

.PopupMenu .Button:hover { background-color: rgb(110, 153, 201); color: rgb(255, 255, 255); }

.Attention { color: red; }

.AttentionBold { font-weight: bold; color: red; }

.OKCancelButton { width: 80px; }

.MenuItem { color: white; font-size: 18px; line-height: 2em; }

a.MenuItem:link, a.MenuItem:visited, a.MenuItem:active { color: white; text-decoration: none; }

a.MenuItem:hover { text-decoration: underline; }

.Toolbox { background-color: buttonface; padding: 2px; }

.ToolboxItem { border-color: window; border-style: solid; border-width: 2px; width: 52px; height: 52px; }

.Grid { background-color: white; border-color: rgb(204, 204, 204); border-width: 1px; border-style: solid; }

.GridHeader { color: white; background-color: rgb(110, 153, 201); }

.GridItem { color: rgb(0, 0, 102); }

.GridItemAlt { color: rgb(0, 0, 102); background: rgb(238, 238, 238); }

.GridItem:hover { background-color: rgb(221, 221, 221); }

.GridItemAlt:hover { background-color: rgb(221, 221, 221); }

.GridFooter { color: white; background-color: rgb(110, 153, 201); }

.GridPager { color: white; background-color: rgb(110, 153, 201); text-align: center; font-weight: bold; }

.Title { font-size: 18px; }

a.Title:link, a.Title:visited, a.Title:active { text-decoration: none; }

a.Title:hover { text-decoration: underline; }

.Header { font-size: 14px; }

.Banner { padding: 8px; }

.BannerText { font-weight: bold; color: white; }

a.BannerText:link, a.BannerText:visited, a.BannerText:active { text-decoration: none; color: white; }

a.BannerText:hover { text-decoration: underline; color: white; }

.PageSelector { font-family: Verdana, sans-serif; margin: 0px 0px 0px 10px; }

.PageSelector label { font-weight: bold; }

.DisplayFilters { margin-right: 3px; min-width: 0px; position: relative; }

.SearchBar { background-color: rgb(238, 238, 238); border: 1px solid rgb(187, 187, 187); height: 30px; margin: -5px 0px 5px; padding: 0px; text-align: center; }

.SearchBar .SearchBox, .SearchBar .SearchButton { height: 30px; margin: 0px; padding: 0px; }

.SearchBar .TextBox { border: 1px solid rgb(0, 0, 0); height: 19px; margin: 2px 0px 0px; padding: 2px 3px 0px; width: 250px; }

.SearchLinks { display: inline; font-family: Verdana, sans-serif; z-index: 9; }

.SearchLinks a span { display: none; }

